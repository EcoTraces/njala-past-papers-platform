# =====================================================================
# Njala Past Papers & Exam Practice Platform - environment variables
# Copy this file to .env in each app directory (apps/web/.env,
# apps/api/.env, apps/document-service/.env) and fill in real values.
# NEVER commit a real .env file.
# =====================================================================

# ---------------------------------------------------------------------
# Supabase (shared by apps/api and apps/web)
# ---------------------------------------------------------------------
# Project URL, e.g. https://xxxxx.supabase.co
SUPABASE_URL=
# Public anon key - safe to expose to the browser (apps/web)
SUPABASE_ANON_KEY=
# Service role key - SERVER ONLY. Never send to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string for migrations / direct queries from apps/api
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres
# Storage bucket used for examination paper files
SUPABASE_STORAGE_BUCKET=examination-papers

# Domain used to synthesize internal Supabase Auth identifiers from
# student IDs (students never see or use this). Must not resolve to a
# real mailbox. See docs/security/authentication.md.
STUDENT_AUTH_IDENTIFIER_DOMAIN=students.njala.auth.internal

# ---------------------------------------------------------------------
# apps/api (Node.js / Fastify)
# ---------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_APP_URL=http://localhost:5173

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# CORS - comma separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Signed URL expiry (seconds) for paper downloads/views
SIGNED_URL_EXPIRY_SECONDS=300

# Document processing service
DOCUMENT_SERVICE_URL=http://localhost:8000
DOCUMENT_SERVICE_CALLBACK_SECRET=change-me-in-production

# Logging
LOG_LEVEL=info

# ---------------------------------------------------------------------
# apps/document-service (Python / FastAPI)
# ---------------------------------------------------------------------
DOCUMENT_SERVICE_PORT=8000
DOCUMENT_SERVICE_ENV=development
# Shared secret the Node API must present when calling this service,
# and that this service presents when calling back the Node API.
DOCUMENT_SERVICE_SHARED_SECRET=change-me-in-production
NODE_API_CALLBACK_URL=http://localhost:4000/api/internal/processing-callback
TESSERACT_CMD=tesseract
OCR_LANGUAGE=eng
MAX_UPLOAD_MB=25

# ---------------------------------------------------------------------
# apps/web (React / Vite) - all VITE_ vars are exposed to the browser
# ---------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://localhost:4000/api
VITE_APP_NAME="Njala Past Papers & Exam Practice Platform"
